{
	"name": "request-desk",
	"version": "1.0.0",
	"private": true,
	"description": "Tracer - HTTP workspace (MERN monorepo)",
	"workspaces": [
		"frontend",
		"backend"
	],
	"scripts": {
		"prestart": "bash setup.sh --start",
		"start": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:frontend": "cd frontend && bun run dev",
		"dev:backend": "cd backend && bun run dev",
		"seed": "cd backend && bun run seed",
		"demo:flight-recorder": "cd backend && bun src/features/execution-intelligence/flight-recorder-demo.js",
		"demo:investigation": "cd backend && bun src/features/execution-intelligence/investigation-demo.js",
		"tracer": "cd backend && bun src/features/cli/main.js",
		"test": "bun run test:backend && bun run test:frontend",
		"test:backend": "cd backend && bun test",
		"test:frontend": "cd frontend && bun test"
	},
	"devDependencies": {
		"concurrently": "9.2.1"
	}
}
